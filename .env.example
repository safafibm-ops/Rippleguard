# ---------------------------------------------------------------------------
# RippleGuard configuration. Copy to .env and edit, or just export these.
# EVERY SETTING IS OPTIONAL. With no configuration at all, RippleGuard runs
# against OSV, deps.dev, ecosyste.ms and the npm registry, none of which
# require an API key.
# ---------------------------------------------------------------------------

# --- Optional API credentials ----------------------------------------------

# Raises the GitHub API rate limit from 60 to 5,000 requests/hour. Without it
# repository scanning still works, but you will hit the limit after a few scans.
# Needs no scopes for public repositories.
GITHUB_TOKEN=

# Enables the written narration on the package detail panel. Everything else,
# including all scores and explanations, is computed without a model.
ANTHROPIC_API_KEY=
RG_LLM_MODEL=claude-sonnet-4-6

# --- Behaviour --------------------------------------------------------------

# Serve every request from the SQLite cache and never touch the network.
# Useful for demoing on conference wifi after one warm-up scan.
RG_OFFLINE=false

# Where the HTTP response cache lives, and how long entries stay fresh.
RG_CACHE=./rippleguard-cache.sqlite
RG_CACHE_TTL=43200

# Scan bounds. Raise max_packages for large monorepos; scans get slower linearly.
RG_MAX_PACKAGES=400
RG_MAX_DEPTH=6
RG_CONCURRENCY=12
RG_HTTP_TIMEOUT=20

# devDependencies are included by default. They matter here: an install hook in
# a dev dependency still executes in CI.
RG_INCLUDE_DEV=true

# --- Data source endpoints (override for mirrors or air-gapped deployments) --
RG_OSV_API=https://api.osv.dev
RG_DEPSDEV_API=https://api.deps.dev
RG_ECOSYSTEMS_API=https://packages.ecosyste.ms/api/v1
RG_NPM_REGISTRY=https://registry.npmjs.org
RG_GITHUB_API=https://api.github.com
